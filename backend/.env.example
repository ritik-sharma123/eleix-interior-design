# Server
PORT=5000
NODE_ENV=development

# MongoDB
# If MONGO_URI is left empty or unreachable, the API automatically falls back
# to an in-memory mock data store so the app still runs for a demo.
MONGO_URI=mongodb://127.0.0.1:27017/eleix_interior

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# First admin seed account (used only by `npm run seed`)
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@eleixinteriors.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Frontend origin (CORS)
CLIENT_URL=http://localhost:5173

# Business / WhatsApp config (also mirrored on the frontend .env)
BUSINESS_WHATSAPP_NUMBER=919999999999
BUSINESS_PHONE=+91 99999 99999
BUSINESS_EMAIL=hello@eleixinteriors.com
